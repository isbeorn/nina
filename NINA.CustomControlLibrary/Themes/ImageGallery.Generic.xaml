<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.CustomControlLibrary"
    xmlns:locale="clr-namespace:NINA.Core.Locale;assembly=NINA.Core">

    <Style TargetType="{x:Type local:ImageGallery}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Grid Background="{TemplateBinding Background}">
                                    <Ellipse
                                        x:Name="Indicator"
                                        Width="10"
                                        Height="10"
                                        Fill="Transparent"
                                        Stroke="{DynamicResource PrimaryBrush}"
                                        StrokeThickness="1.5" />
                                    <Rectangle
                                        x:Name="FocusOutline"
                                        Margin="2"
                                        Stroke="{DynamicResource PrimaryBrush}"
                                        StrokeDashArray="1,1"
                                        Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Indicator" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageGallery}">
                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            x:Name="PART_Image"
                            Grid.Column="1"
                            Source="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                            Stretch="Uniform" />
                        <Button
                            x:Name="PART_PreviousButton"
                            Width="32"
                            Height="36"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{locale:Loc LblImageGalleryPrevious}"
                            Command="{x:Static NavigationCommands.PreviousPage}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{DynamicResource BackgroundButton}"
                            ToolTip="{locale:Loc LblImageGalleryPrevious}">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{DynamicResource ArrowLeftSVG}"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                Stretch="Uniform" />
                        </Button>
                        <Button
                            x:Name="PART_NextButton"
                            Grid.Column="2"
                            Width="32"
                            Height="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{locale:Loc LblImageGalleryNext}"
                            Command="{x:Static NavigationCommands.NextPage}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{DynamicResource BackgroundButton}"
                            ToolTip="{locale:Loc LblImageGalleryNext}">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{DynamicResource ArrowRightSVG}"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                Stretch="Uniform" />
                        </Button>
                        <ItemsPresenter
                            x:Name="PART_Indicators"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="PART_PreviousButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Indicators" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                            <Setter TargetName="PART_PreviousButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Indicators" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
