
<UserControl
    x:Class="NINA.Sequencer.Logic.ExprControlVariable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Sequencer.Logic">
    <UserControl.Resources>
        <local:ExprConverter x:Key="ec" />
    </UserControl.Resources>
    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock
            Margin="5,0,5,0"
            VerticalAlignment="Center"
            Text="{Binding Label, RelativeSource={RelativeSource AncestorType={x:Type local:ExprControlVariable}}}" />
        <TextBox
            MinWidth="20"
            Margin="5,-3,0,-5"
            VerticalAlignment="Center"
            Foreground="{StaticResource SequencerExpressionTextBrush}"
            Text="{Binding Exp.Definition, RelativeSource={RelativeSource AncestorType={x:Type local:ExprControlVariable}}}"
            ToolTip="Foo"
            ToolTipOpening="ShowConstants" />
        <TextBlock
            Margin="5,-4,10,-4"
            VerticalAlignment="Center"
            Foreground="{StaticResource SequencerExpressionTextBrush}">
            <TextBlock.Visibility>
                <Binding
                    Converter="{StaticResource BooleanToVisibilityCollapsedConverter}"
                    Path="Exp.IsAnnotated"
                    RelativeSource="{RelativeSource AncestorType={x:Type local:ExprControlVariable}}" />
            </TextBlock.Visibility>
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ec}">
                    <Binding Path="Exp" RelativeSource="{RelativeSource AncestorType={x:Type local:ExprControlVariable}}" />
                    <Binding
                        Mode="OneWay"
                        Path="Exp.ValueString"
                        RelativeSource="{RelativeSource AncestorType={x:Type local:ExprControlVariable}}" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </StackPanel>
</UserControl>


