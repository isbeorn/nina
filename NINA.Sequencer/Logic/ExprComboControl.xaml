<UserControl
    x:Class="NINA.Sequencer.Logic.ExprComboControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Sequencer.Logic">
    <UserControl.Resources>
        <local:ExprConverter x:Key="ec" />
    </UserControl.Resources>
    <StackPanel
        VerticalAlignment="Center"
        DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ExprComboControl}}}"
        Orientation="Horizontal">
        <TextBlock Margin="3,-5,0,-4" VerticalAlignment="Center">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ec}" Mode="TwoWay">
                    <Binding Mode="TwoWay" Path="Exp" />
                    <Binding Mode="OneWay" Path="Exp.ValueString" />
                    <Binding Path="Combo" />
                </MultiBinding>
            </TextBlock.Text>
            <TextBlock.Foreground>
                <SolidColorBrush Color="GreenYellow" />
            </TextBlock.Foreground>
        </TextBlock>
    </StackPanel>
</UserControl>


