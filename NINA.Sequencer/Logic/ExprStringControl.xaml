<UserControl
    x:Class="NINA.Sequencer.Logic.ExprStringControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="root"
    VerticalAlignment="Center">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
    
        <!-- Maybe the colon/space should be an option or part of the localized label -->
        <StackPanel
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Visibility="{Binding Label, ElementName=root, Converter={StaticResource NullToVisibilityCollapsedConverter}}">
            <TextBlock
               VerticalAlignment="Center" 
               Text="{Binding Label, ElementName=root}" />

            <TextBlock
               VerticalAlignment="Center"
               Text=": " />
        </StackPanel>

        <TextBox
            Grid.Column="1"
            MinWidth="40"
            Margin="5,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            AcceptsReturn="{Binding AcceptsReturn, ElementName=root}"
            Text="{Binding Text, ElementName=root, UpdateSourceTrigger=LostFocus}"
            TextAlignment="Left"
            ToolTip="{Binding ProcessedText, ElementName=root}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="Padding" Value="5,0,5,0" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AcceptsReturn, ElementName=root}" Value="True">
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="Padding" Value="5,2,5,2" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
    </Grid>
</UserControl>