<UserControl
    x:Class="NINA.Sequencer.Logic.ExpandableStringControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        
        <TextBlock 
            VerticalAlignment="Center" 
            Text="{Binding Label, ElementName=root}" 
            Visibility="{Binding Label, ElementName=root, Converter={StaticResource NullToVisibilityCollapsedConverter}}" />
        
        <TextBox
            Grid.Column="1"
            MinWidth="40"
            Margin="5,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Text="{Binding Text, ElementName=root, UpdateSourceTrigger=LostFocus}"
            TextAlignment="Left"
            ToolTip="{Binding ProcessedText, ElementName=root}" />
    </Grid>
</UserControl>