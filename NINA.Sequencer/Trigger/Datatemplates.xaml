                        <StackPanel
                            Grid.Column="1"
                            Margin="10,3,10,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <StackPanel
                                HorizontalAlignment="Right"
