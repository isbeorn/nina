                            <TextBlock
                                HorizontalAlignment="Left"
                                Text="{ns:Loc Lbl_SequenceTrigger_AutofocusAfterHFRIncreaseTrigger_SampleSizeTooltip}"
                                TextAlignment="Left" />
                        </TextBox.ToolTip>-->
