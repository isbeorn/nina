<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0" assemblyQualifiedName="Microsoft.VisualStudio.Coverage.DynamicCoverageDataCollector, Microsoft.VisualStudio.TraceCollector, Version=18.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]NINA\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Astrometry\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Core\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.CustomControlLibrary\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Equipment\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Image\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.MGEN\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.PlateSolving\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Plugin\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Profile\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.Sequencer\.dll$</ModulePath>
                <ModulePath>.*[\\/]NINA\.WPF\.Base\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*[\\/]Trinet\.Core\.IO\.Ntfs\.dll$</ModulePath>
                <ModulePath>.*[\\/]Accord\.Imaging.*\.dll$</ModulePath>
                <ModulePath>.*[\\/]OxyPlot.*\.dll$</ModulePath>
                <ModulePath>.*[\\/]ASCOM\.Common.*\.dll$</ModulePath>
                <ModulePath>.*[\\/]nikoncswrapper\.dll$</ModulePath>
                <ModulePath>.*[\\/]ASCOM\.Alpaca.*\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <UseVerifiableInstrumentation>False</UseVerifiableInstrumentation>
            <AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>
            <CollectFromChildProcesses>True</CollectFromChildProcesses>
            <CollectAspDotNet>False</CollectAspDotNet>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
