<Window
    x:Class="NINA.Core.Utility.Notification.NotificationHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreutil="clr-namespace:NINA.Core.Utility"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notification="clr-namespace:NINA.Core.Utility.Notification"
    xmlns:ns="clr-namespace:NINA.Core.Locale"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>

        <DataTemplate DataType="{x:Type notification:CustomNotification}">
            <Border
                MinHeight="130"
                MaxWidth="500"
                Margin="0,0,0,3"
                Background="{Binding Background}"
                BorderThickness="0">
                <Grid Margin="5" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!--  Header row: logo + title + version + close button  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image
                                Width="20"
                                Height="15"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Source="/NINA.Core;component/Resources/Logo_Nina.png" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#FFAAAAAA"
                                Text="{Binding Source={x:Static coreutil:CoreUtil.Title}}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#FFAAAAAA"
                                Text="{Binding Source={x:Static coreutil:CoreUtil.VersionFriendlyName}}" />
                        </StackPanel>

                        <!--  Close single toast  -->
                        <Button
                            Grid.Column="1"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Background="{Binding Background}"
                            Command="{Binding CloseCommand}"
                            Visibility="Visible">
                            <Path
                                Width="10"
                                Margin="5"
                                Data="{StaticResource CancelSVG}"
                                Fill="#FFAAAAAA"
                                RenderTransformOrigin="0.5,0.5"
                                Stretch="Uniform"
                                UseLayoutRounding="True" />
                        </Button>
                    </Grid>

                    <!--  Content row: icon + text + timestamp + close-all  -->
                    <Grid Grid.Row="1" Margin="0,2.5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Path
                            Grid.Row="1"
                            Width="50"
                            VerticalAlignment="Top"
                            Data="{Binding Symbol}"
                            Fill="{Binding Color}"
                            Stretch="Uniform"
                            UseLayoutRounding="True"
                            Visibility="{Binding Symbol, Converter={StaticResource NullToVisibilityCollapsedConverter}}" />

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                VerticalAlignment="Top"
                                FontSize="15"
                                Foreground="White"
                                Text="{Binding Header}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Top"
                                FontSize="15"
                                Foreground="#FFAAAAAA"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                FontSize="12"
                                Foreground="#FFAAAAAA"
                                Text="{Binding DateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />

                            <!--  Close all toasts  -->
                            <Button
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                Padding="1"
                                HorizontalAlignment="Right"
                                Background="{Binding Background}"
                                Command="{Binding CloseAllCommand}"
                                Visibility="Visible">
                                <Run Foreground="#FFAAAAAA" Text="{ns:Loc LblCloseAll}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!--  Toast stack  -->
    <Grid>
        <ItemsControl ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
