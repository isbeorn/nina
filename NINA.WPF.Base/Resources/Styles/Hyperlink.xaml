<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:NINA.WPF.Base.Behaviors">
    <Style x:Key="ApplicationHyperlinkStyle" TargetType="{x:Type Hyperlink}">
        <Setter Property="behavior:HyperlinkBehavior.IsEnabled" Value="True" />
    </Style>
    <Style BasedOn="{StaticResource ApplicationHyperlinkStyle}" TargetType="{x:Type Hyperlink}" />
</ResourceDictionary>
